APP_NAME=Stashly
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_URL=http://127.0.0.1:3000
APP_HOST=127.0.0.1
APP_PORT=3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stashly
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public

QUEUE_CONNECTION=database

# Largest single upload in bytes (50 MB by default).
MAX_FILE_SIZE=52428800
# How many days a finished archive stays downloadable.
ARCHIVE_TTL_DAYS=5
# Uploads allowed per minute and per client.
UPLOAD_RATE_PER_MINUTE=60

# Comma separated list of browser origins allowed by CORS. "*" allows every origin.
CORS_ALLOWED_ORIGINS=*

# Mail. "smtp" is the default and the only value a real deployment may use.
# "log" writes the message (one time codes included) to the application log
# instead of sending it; it is refused unless APP_ENV is local or testing, so
# set MAIL_MAILER=log in your own local .env and leave this file on smtp.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (STARTTLS, port 587), ssl (implicit TLS, port 465) or none.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@stashly.local
MAIL_FROM_NAME=Stashly

# Password of the super admin the seeder creates (stashly@example.com).
SEED_ADMIN_PASSWORD=ChangeMe123!
